@model ParkingManagement.Web.ViewModels.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_AuthLayout";
}

<section class="auth-page">

    <div class="auth-shell">

        <!-- =========================
             LEFT SIDE
        ========================== -->
        <div class="auth-visual">

            <div class="auth-visual-overlay"></div>

            <div class="auth-visual-content">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-brand">

                    <img src="~/images/logo.png"
                         alt="OmniPark"
                         class="auth-brand-logo" />

                </a>


                <div class="auth-intro">

                    <span class="auth-kicker">
                        OMNIPARK
                    </span>

                    <h1>
                        Đỗ xe dễ dàng,<br />
                        <span>cuộc sống nhẹ nhàng</span>
                    </h1>

                    <p>
                        Tạo tài khoản OmniPark để tìm bãi xe,
                        đặt chỗ và quản lý hành trình của bạn dễ dàng hơn.
                    </p>

                </div>


                <div class="auth-benefits">

                    <div class="auth-benefit-item">

                        <div class="auth-benefit-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <div>
                            <strong>Tìm kiếm dễ dàng</strong>
                            <span>Tìm bãi xe phù hợp chỉ trong vài giây</span>
                        </div>

                    </div>


                    <div class="auth-benefit-item">

                        <div class="auth-benefit-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div>
                            <strong>Đặt chỗ nhanh chóng</strong>
                            <span>Chủ động đặt trước chỗ đỗ xe</span>
                        </div>

                    </div>


                    <div class="auth-benefit-item">

                        <div class="auth-benefit-icon">
                            <i class="bi bi-credit-card"></i>
                        </div>

                        <div>
                            <strong>Thanh toán tiện lợi</strong>
                            <span>Quản lý thanh toán nhanh chóng, rõ ràng</span>
                        </div>

                    </div>

                </div>


                <div class="auth-visual-footer">
                    © @DateTime.Now.Year OmniPark. Smart Parking. Better Living.
                </div>

            </div>

        </div>


        <!-- =========================
             RIGHT SIDE
        ========================== -->
        <div class="auth-form-side">

            <div class="auth-card auth-register-card">

                <div class="auth-card-heading">

                    <span class="auth-card-label">
                        Bắt đầu với OmniPark
                    </span>

                    <h2>Đăng ký</h2>

                    <p>
                        Tạo tài khoản mới để sử dụng hệ thống.
                    </p>

                </div>


                <form asp-controller="Account"
                      asp-action="Register"
                      method="post"
                      class="auth-form">

                    <div asp-validation-summary="ModelOnly"
                         class="auth-validation-summary"
                         role="alert">
                    </div>


                    <!-- FULL NAME -->
                    <div class="auth-field">

                        <label asp-for="FullName">
                            Họ và tên
                        </label>

                        <div class="auth-input-wrap">

                            <i class="bi bi-person"></i>

                            <input asp-for="FullName"
                                   placeholder="Nhập họ và tên"
                                   autocomplete="name" />

                        </div>

                        <span asp-validation-for="FullName"
                              class="auth-field-error">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="auth-field">

                        <label asp-for="Email">
                            Email
                        </label>

                        <div class="auth-input-wrap">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   type="email"
                                   placeholder="Nhập email của bạn"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="auth-field-error">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="auth-field">

                        <label asp-for="Phone">
                            Số điện thoại
                        </label>

                        <div class="auth-input-wrap">

                            <i class="bi bi-telephone"></i>

                            <input asp-for="Phone"
                                   type="tel"
                                   placeholder="Nhập số điện thoại"
                                   autocomplete="tel" />

                        </div>

                        <span asp-validation-for="Phone"
                              class="auth-field-error">
                        </span>

                    </div>


                    <!-- PASSWORD -->
                    <div class="auth-field">

                        <label asp-for="Password">
                            Mật khẩu
                        </label>

                        <div class="auth-input-wrap">

                            <i class="bi bi-lock"></i>

                            <input asp-for="Password"
                                   id="registerPassword"
                                   type="password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('registerPassword', this)"
                                    aria-label="Hiện hoặc ẩn mật khẩu">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="auth-field-error">
                        </span>

                    </div>


                    <!-- POLICY -->
                    <label class="auth-policy">

                        <input type="checkbox"
                               required />

                        <span>
                            Tôi đồng ý với
                            <a href="#">Điều khoản sử dụng</a>
                            và
                            <a href="#">Chính sách bảo mật</a>
                        </span>

                    </label>


                    <!-- SUBMIT -->
                    <button type="submit"
                            class="auth-submit-btn">

                        <span>Đăng ký</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>


                    <!-- DIVIDER -->
                    <div class="auth-divider">

                        <span>Hoặc đăng ký với</span>

                    </div>


                    <!-- SOCIAL -->
                    <div class="auth-social-row">

                        <!-- GOOGLE -->
                        <button type="button"
                                class="auth-social-btn">

                            <svg class="google-logo"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path fill="#4285F4"
                                      d="M21.35 12.25c0-.7-.06-1.2-.2-1.72H12v3.3h5.37a4.6 4.6 0 0 1-2 3.01l-.02.11 2.9 2.24.2.02c1.84-1.7 2.9-4.2 2.9-6.96z" />

                                <path fill="#34A853"
                                      d="M12 21.75c2.62 0 4.82-.86 6.43-2.34l-3.06-2.37c-.82.55-1.92.94-3.37.94-2.52 0-4.66-1.7-5.43-4.05l-.1.01-3.02 2.34-.04.1A9.72 9.72 0 0 0 12 21.75z" />

                                <path fill="#FBBC05"
                                      d="M6.57 13.93A5.87 5.87 0 0 1 6.25 12c0-.67.12-1.31.31-1.92l-.01-.13-3.06-2.38-.1.05A9.73 9.73 0 0 0 2.25 12c0 1.57.37 3.05 1.16 4.38l3.16-2.45z" />

                                <path fill="#EA4335"
                                      d="M12 6.02c1.82 0 3.05.79 3.75 1.44l2.74-2.67C16.81 3.22 14.62 2.25 12 2.25a9.72 9.72 0 0 0-8.59 5.37l3.15 2.46C7.34 7.73 9.48 6.02 12 6.02z" />

                            </svg>

                            <span>Google</span>

                        </button>


                        <!-- FACEBOOK -->
                        <button type="button"
                                class="auth-social-btn">

                            <i class="bi bi-facebook facebook-mark"></i>

                            <span>Facebook</span>

                        </button>

                    </div>

                    <div class="auth-switch">

                        Đã có tài khoản?

                        <a asp-controller="Account"
                           asp-action="Login">
                            Đăng nhập ngay
                        </a>

                    </div>
                    <div class="auth-switch mt-2">
                        Bạn muốn đăng ký kinh doanh bãi xe?
                        <a asp-controller="Account"
                           asp-action="RegisterOwner">
                            Đăng ký làm chủ bãi xe
                        </a>
                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

            } else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}