@using ParkingManagement.Web.ViewModels.Employee
@{
    ViewData["Title"] = "Check-in xe";
    var availableSlots = ViewBag.AvailableSlots as List<AvailableSlotViewModel> ?? new List<AvailableSlotViewModel>();
}

<style>
    :root {
        --omni-navy: #0b1f3a;
        --omni-blue: #1570ef;
        --omni-blue-dark: #175cd3;
        --omni-blue-soft: #eff6ff;
        --omni-green: #12b76a;
        --omni-green-dark: #067647;
        --omni-green-soft: #ecfdf3;
        --omni-purple: #7f56d9;
        --omni-purple-soft: #f4f3ff;
        --omni-orange: #f79009;
        --omni-border: #d0d5dd;
        --omni-text: #101828;
        --omni-muted: #667085;
        --omni-surface: #ffffff;
        --omni-page: #f8fafc;
    }

    .checkin-page {
        max-width: 1560px;
        margin: 0 auto;
        padding: 32px 24px 48px;
    }

    .checkin-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding: 22px 24px;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #f4f8ff 0%, #ffffff 58%, #f6fbff 100%);
        border: 1px solid #cfe0ff;
        border-left: 5px solid var(--omni-blue);
    }

    .checkin-title {
        margin: 0 0 8px;
        font-size: 40px;
        line-height: 1.1;
        color: var(--omni-navy);
        font-weight: 800;
    }

    .checkin-subtitle {
        margin: 0;
        color: var(--omni-muted);
        font-size: 16px;
    }

    .checkin-stats {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .stat-card {
        min-width: 190px;
        padding: 13px 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--omni-border);
        background: var(--omni-surface);
    }

        .stat-card.blue {
            background: var(--omni-blue-soft);
            border-color: #b2ccff;
        }

        .stat-card.green {
            background: var(--omni-green-soft);
            border-color: #abefc6;
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 19px;
        background: #fff;
        border: 1px solid currentColor;
    }

    .stat-card.blue .stat-icon {
        color: var(--omni-blue-dark);
    }

    .stat-card.green .stat-icon {
        color: var(--omni-green-dark);
    }

    .stat-copy span {
        display: block;
        color: var(--omni-muted);
        font-size: 12px;
        margin-bottom: 3px;
    }

    .stat-copy strong {
        color: var(--omni-text);
        font-size: 22px;
        line-height: 1;
    }

    .stat-copy small {
        color: var(--omni-muted);
        font-size: 12px;
        font-weight: 600;
    }

    .checkin-message {
        padding: 12px 16px;
        margin-bottom: 18px;
        border: 1px solid;
        border-left-width: 4px;
        font-weight: 600;
    }

        .checkin-message.error {
            color: #b42318;
            background: #fef3f2;
            border-color: #fecdca;
            border-left-color: #f04438;
        }

        .checkin-message.success {
            color: var(--omni-green-dark);
            background: var(--omni-green-soft);
            border-color: #abefc6;
            border-left-color: var(--omni-green);
        }

    .checkin-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .checkin-panel {
        background: #fff;
        border: 1px solid var(--omni-border);
        padding: 0 24px 24px;
        min-height: 500px;
    }

        .checkin-panel.booking-panel {
            border-left: 5px solid var(--omni-blue);
        }

        .checkin-panel.walkin-panel {
            border-left: 5px solid var(--omni-purple);
        }

    .checkin-panel-header {
        margin: 0 -24px 16px;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #e4e7ec;
        background: #f8fafc;
    }

    .booking-panel .checkin-panel-header {
        background: #f5f9ff;
    }

    .walkin-panel .checkin-panel-header {
        background: #faf8ff;
    }

    .checkin-panel-title {
        margin: 0;
        color: var(--omni-navy);
        font-size: 22px;
        font-weight: 800;
    }

    .flow-badge {
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .2px;
        border: 1px solid;
    }

        .flow-badge.booking {
            color: var(--omni-blue-dark);
            background: var(--omni-blue-soft);
            border-color: #b2ccff;
        }

        .flow-badge.walkin {
            color: #6941c6;
            background: var(--omni-purple-soft);
            border-color: #d9d6fe;
        }

    .checkin-panel-desc {
        margin: 0 0 20px;
        color: var(--omni-muted);
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: var(--omni-text);
        font-size: 15px;
        font-weight: 700;
    }

    .form-control-omni {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        background: #fff;
        border: 1px solid #cfd4dc;
        color: var(--omni-text);
        font-size: 16px;
        outline: 0;
        border-radius: 0;
        transition: .15s ease;
    }

        .form-control-omni:hover {
            border-color: #98a2b3;
        }

        .form-control-omni:focus {
            border-color: var(--omni-blue);
            box-shadow: 0 0 0 2px rgba(21,112,239,.12);
        }

    .form-hint {
        margin-top: 6px;
        color: #98a2b3;
        font-size: 12px;
    }

    .availability-strip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        margin: 4px 0 20px;
        background: var(--omni-green-soft);
        color: var(--omni-green-dark);
        border: 1px solid #abefc6;
        border-left: 4px solid var(--omni-green);
        font-size: 13px;
        font-weight: 700;
    }

    .btn-omni {
        min-width: 290px;
        height: 48px;
        padding: 0 22px;
        border: 1px solid;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        border-radius: 0;
        transition: .15s ease;
    }

    .btn-primary-omni {
        color: #fff;
        background: var(--omni-blue);
        border-color: var(--omni-blue);
        box-shadow: 0 3px 0 #0d56ba;
    }

        .btn-primary-omni:hover {
            background: var(--omni-blue-dark);
            border-color: var(--omni-blue-dark);
        }

    .btn-walkin-omni {
        color: #fff;
        background: var(--omni-purple);
        border-color: var(--omni-purple);
        box-shadow: 0 3px 0 #6941c6;
    }

        .btn-walkin-omni:hover {
            background: #6941c6;
            border-color: #6941c6;
        }

    .bottom-actions {
        margin-top: 18px;
    }

    .goto-checkout {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 48px;
        padding: 0 20px;
        color: #b54708;
        background: #fffaeb;
        border: 1px solid #fdb022;
        border-left: 4px solid var(--omni-orange);
        text-decoration: none;
        font-weight: 800;
    }

        .goto-checkout:hover {
            color: #93370d;
            background: #fef0c7;
            text-decoration: none;
        }
    /* ======================================================
       CHỌN VỊ TRÍ ĐỖ
    ====================================================== */

    .slot-picker {
        margin-top: 8px;
    }

    .slot-picker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 12px;
        margin-top: 10px;
    }

    .slot-picker-item {
        min-height: 78px;
        padding: 10px 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 2px solid #d0d5dd;
        background: #ffffff;
        color: #101828;
        cursor: pointer;
        font-family: inherit;
        transition: .15s ease;
    }

        .slot-picker-item:hover {
            border-color: #12b76a;
            background: #f6fef9;
            transform: translateY(-2px);
        }

        .slot-picker-item.selected {
            color: #ffffff;
            background: #12b76a;
            border-color: #067647;
            box-shadow: 0 0 0 3px rgba(18, 183, 106, .14);
        }

    .booking-panel .slot-picker-item.selected {
        background: #1570ef;
        border-color: #175cd3;
        box-shadow: 0 0 0 3px rgba(21, 112, 239, .14);
    }

    .slot-picker-code {
        font-size: 17px;
        font-weight: 800;
    }

    .slot-picker-status {
        margin-top: 4px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #667085;
    }

    .slot-picker-item.selected .slot-picker-status {
        color: #ffffff;
    }

    .selected-slot-message {
        display: none;
        margin-top: 10px;
        padding: 9px 12px;
        border: 1px solid #abefc6;
        border-left: 4px solid #12b76a;
        background: #ecfdf3;
        color: #067647;
        font-size: 13px;
        font-weight: 700;
    }

    .booking-panel .selected-slot-message {
        border-color: #b2ccff;
        border-left-color: #1570ef;
        background: #eff6ff;
        color: #175cd3;
    }

    @@media (max-width: 1100px) {
        .checkin-hero {
            flex-direction: column;
        }

        .checkin-stats {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 850px) {
        .checkin-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .checkin-page {
            padding: 22px 12px 40px;
        }

        .checkin-title {
            font-size: 32px;
        }

        .checkin-panel {
            padding: 0 18px 20px;
        }

        .checkin-panel-header {
            margin: 0 -18px 15px;
            padding: 14px 18px;
        }

        .btn-omni {
            width: 100%;
            min-width: 0;
        }

        .goto-checkout {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="checkin-page">
    <div class="checkin-hero">
        <div>
            <h1 class="checkin-title">Check-in xe</h1>
            <p class="checkin-subtitle">Thực hiện check-in cho khách có booking hoặc khách vãng lai</p>
        </div>

        <div class="checkin-stats">
            <div class="stat-card blue">
                <div class="stat-icon">P</div>
                <div class="stat-copy">
                    <span>Vị trí khả dụng</span>
                    <strong>@availableSlots.Count <small>chỗ</small></strong>
                </div>
            </div>
            <div class="stat-card green">
                <div class="stat-icon">✓</div>
                <div class="stat-copy">
                    <span>Hệ thống</span>
                    <strong>Sẵn sàng</strong>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="checkin-message error" role="alert">@ViewBag.Error</div>
    }
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="checkin-message success" role="status">@ViewBag.SuccessMessage</div>
    }

    <div class="checkin-grid">
        <section class="checkin-panel booking-panel">
            <div class="checkin-panel-header">
                <h2 class="checkin-panel-title">Check-in có Booking</h2>
                <span class="flow-badge booking">LUỒNG BOOKING</span>
            </div>
            <p class="checkin-panel-desc">Nhập thông tin booking và chọn vị trí đỗ để thực hiện check-in.</p>

            <form method="post" asp-action="CheckInWithBooking">
                <div class="form-group">
                    <label class="form-label" for="bookingId">Mã Booking</label>
                    <input id="bookingId" type="number" name="BookingId" class="form-control-omni" min="1" placeholder="Ví dụ: 4" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="bookingPlate">Biển số xe</label>
                    <input id="bookingPlate" type="text" name="LicensePlate" class="form-control-omni" placeholder="Ví dụ: 76C12345" autocomplete="off" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Vị trí đỗ</label>

                    <input type="hidden"
                           id="bookingSlot"
                           name="ParkingSlotId"
                           value="@ViewBag.SelectedParkingSlotId"
                           required />

                    <div class="slot-picker">
                        <div class="slot-picker-grid"
                             data-target-input="bookingSlot"
                             data-message="bookingSelectedMessage">

                            @foreach (var slot in availableSlots)
                            {
                                var isSelected =
                                ViewBag.SelectedParkingSlotId != null &&
                                slot.ParkingSlotId == (int)ViewBag.SelectedParkingSlotId;

                                <button type="button"
                                        class="slot-picker-item @(isSelected ? "selected" : "")"
                                        data-slot-id="@slot.ParkingSlotId"
                                        data-slot-code="@slot.SlotCode">

                                    <span class="slot-picker-code">
                                        @slot.SlotCode
                                    </span>

                                    <span class="slot-picker-status">
                                        Trống
                                    </span>
                                </button>
                            }

                        </div>

                        <div id="bookingSelectedMessage"
                             class="selected-slot-message"
                             style="@(ViewBag.SelectedParkingSlotId != null ? "display:block;" : "")">

                            Vị trí đã chọn:
                            <strong id="bookingSelectedCode">
                                @{
                                    var selectedBookingSlot = availableSlots
                                    .FirstOrDefault(x =>
                                    ViewBag.SelectedParkingSlotId != null &&
                                    x.ParkingSlotId == (int)ViewBag.SelectedParkingSlotId);
                                }

                                @(selectedBookingSlot?.SlotCode ?? "")
                            </strong>

                        </div>
                    </div>
                </div>

                <div class="availability-strip">✓ Hiện có @availableSlots.Count vị trí có thể sử dụng</div>

                <button type="submit" class="btn-omni btn-primary-omni">Check-in</button>
            </form>
        </section>

        <section class="checkin-panel walkin-panel">
            <div class="checkin-panel-header">
                <h2 class="checkin-panel-title">Check-in khách vãng lai</h2>
                <span class="flow-badge walkin">LUỒNG VÃNG LAI</span>
            </div>
            <p class="checkin-panel-desc">Nhập thông tin xe chưa có booking và chọn vị trí phù hợp.</p>

            <form method="post" asp-action="CheckInWalkin">
                <div class="form-group">
                    <label class="form-label" for="walkinPlate">Biển số xe</label>
                    <input id="walkinPlate" type="text" name="LicensePlate" class="form-control-omni" placeholder="Ví dụ: 59A12345" autocomplete="off" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="vehicleType">Loại xe (Id)</label>
                    <input id="vehicleType" type="number" name="VehicleTypeId" class="form-control-omni" min="1" placeholder="Nhập ID loại xe" required />
                    <div class="form-hint">Tạm thời giữ nguyên VehicleTypeId theo backend hiện tại.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Vị trí đỗ</label>

                    <input type="hidden"
                           id="walkinSlot"
                           name="ParkingSlotId"
                           required />

                    <div class="slot-picker">

                        <div class="slot-picker-grid"
                             data-target-input="walkinSlot"
                             data-message="walkinSelectedMessage">

                            @foreach (var slot in availableSlots)
                            {
                                <button type="button"
                                        class="slot-picker-item"
                                        data-slot-id="@slot.ParkingSlotId"
                                        data-slot-code="@slot.SlotCode">

                                    <span class="slot-picker-code">
                                        @slot.SlotCode
                                    </span>

                                    <span class="slot-picker-status">
                                        Trống
                                    </span>

                                </button>
                            }

                        </div>

                        <div id="walkinSelectedMessage"
                             class="selected-slot-message">

                            Vị trí đã chọn:
                            <strong id="walkinSelectedCode"></strong>

                        </div>

                    </div>
                </div>

                <div class="availability-strip">✓ Vị trí trống được cập nhật từ hệ thống</div>

                <button type="submit" class="btn-omni btn-walkin-omni">Check-in vãng lai</button>
            </form>
        </section>
    </div>

    <div class="bottom-actions">
        <a asp-action="CheckOut" class="goto-checkout">⇄ Chuyển sang màn hình Check-out</a>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const slotGrids =
            document.querySelectorAll(".slot-picker-grid");

        slotGrids.forEach(function (grid) {

            const inputId =
                grid.dataset.targetInput;

            const messageId =
                grid.dataset.message;

            const hiddenInput =
                document.getElementById(inputId);

            const message =
                document.getElementById(messageId);

            const buttons =
                grid.querySelectorAll(".slot-picker-item");

            buttons.forEach(function (button) {

                button.addEventListener("click", function () {

                    // Bỏ chọn tất cả ô trong đúng khu vực này
                    buttons.forEach(function (item) {
                        item.classList.remove("selected");
                    });

                    // Chọn ô vừa click
                    button.classList.add("selected");

                    const slotId =
                        button.dataset.slotId;

                    const slotCode =
                        button.dataset.slotCode;

                    // Gán ParkingSlotId để submit về Controller
                    hiddenInput.value = slotId;

                    // Hiển thị thông báo vị trí được chọn
                    if (message) {

                        const codeElement =
                            message.querySelector("strong");

                        if (codeElement) {
                            codeElement.textContent = slotCode;
                        }

                        message.style.display = "block";
                    }
                });

            });

        });


        // Chặn submit nếu chưa chọn vị trí
        document.querySelectorAll(".checkin-panel form")
            .forEach(function (form) {

                form.addEventListener("submit", function (event) {

                    const slotInput =
                        form.querySelector(
                            'input[name="ParkingSlotId"]'
                        );

                    if (
                        slotInput &&
                        !slotInput.value
                    ) {

                        event.preventDefault();

                        alert(
                            "Vui lòng chọn vị trí đỗ xe."
                        );
                    }

                });

            });

    });
</script>