@model List<ParkingManagement.Web.ViewModels.Employee.ActiveSessionViewModel>
@{
    ViewData["Title"] = "Check-out xe";
}

<style>
    :root {
        --omni-navy: #0b1f3a;
        --omni-blue: #1570ef;
        --omni-blue-dark: #175cd3;
        --omni-blue-soft: #eff6ff;
        --omni-green: #12b76a;
        --omni-green-dark: #067647;
        --omni-green-soft: #ecfdf3;
        --omni-orange: #f79009;
        --omni-orange-dark: #dc6803;
        --omni-orange-soft: #fffaeb;
        --omni-red: #f04438;
        --omni-border: #d0d5dd;
        --omni-text: #101828;
        --omni-muted: #667085;
    }

    .checkout-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 32px 24px 48px;
    }

    .checkout-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding: 22px 24px;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #fff8ed 0%, #ffffff 55%, #f4f8ff 100%);
        border: 1px solid #fedf89;
        border-left: 5px solid var(--omni-orange);
    }

    .checkout-title {
        margin: 0 0 8px;
        color: var(--omni-navy);
        font-size: 40px;
        font-weight: 800;
        line-height: 1.1;
    }

    .checkout-subtitle {
        margin: 0;
        color: var(--omni-muted);
        font-size: 16px;
    }

    .checkout-stat {
        min-width: 210px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        background: var(--omni-blue-soft);
        border: 1px solid #b2ccff;
    }

    .checkout-stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: var(--omni-blue-dark);
        border: 1px solid var(--omni-blue-dark);
        font-weight: 800;
    }

    .checkout-stat span {
        display: block;
        color: var(--omni-muted);
        font-size: 12px;
        margin-bottom: 3px;
    }

    .checkout-stat strong {
        color: var(--omni-text);
        font-size: 22px;
    }

    .checkout-stat small {
        color: var(--omni-muted);
        font-size: 12px;
        font-weight: 600;
    }

    .checkout-message {
        margin-bottom: 18px;
        padding: 12px 16px;
        background: var(--omni-blue-soft);
        color: var(--omni-blue-dark);
        border: 1px solid #b2ccff;
        border-left: 4px solid var(--omni-blue);
        font-weight: 600;
    }

    .checkout-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        margin-bottom: 16px;
        background: #f8fafc;
        border: 1px solid var(--omni-border);
        border-left: 4px solid var(--omni-blue);
    }

    .checkout-search {
        display: flex;
        flex: 1;
        max-width: 620px;
    }

    .checkout-search-input {
        flex: 1;
        height: 46px;
        padding: 0 14px;
        border: 1px solid #cfd4dc;
        border-right: 0;
        outline: 0;
        font-size: 15px;
        border-radius: 0;
    }

        .checkout-search-input:focus {
            border-color: var(--omni-blue);
            box-shadow: inset 0 0 0 1px var(--omni-blue);
        }

    .checkout-search-btn {
        height: 46px;
        padding: 0 20px;
        color: #fff;
        background: var(--omni-blue);
        border: 1px solid var(--omni-blue);
        font-weight: 800;
        border-radius: 0;
        cursor: pointer;
    }

        .checkout-search-btn:hover {
            background: var(--omni-blue-dark);
        }

    .checkout-count {
        color: #475467;
        font-size: 14px;
        font-weight: 700;
    }

    .checkout-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .checkout-card {
        background: #fff;
        border: 1px solid var(--omni-border);
        border-left: 5px solid var(--omni-orange);
        padding: 0 24px 22px;
    }

    .checkout-card-head {
        margin: 0 -24px 0;
        padding: 15px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        background: #fffaf2;
        border-bottom: 1px solid #f2e6cf;
    }

    .plate-label {
        color: var(--omni-muted);
        font-size: 12px;
        margin-bottom: 3px;
    }

    .plate-number {
        margin: 0;
        color: var(--omni-navy);
        font-size: 26px;
        font-weight: 800;
        letter-spacing: .6px;
    }

    .checkout-status {
        padding: 7px 11px;
        color: var(--omni-green-dark);
        background: var(--omni-green-soft);
        border: 1px solid #abefc6;
        font-size: 12px;
        font-weight: 800;
    }

    .checkout-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 18px;
        border-top: 1px solid #eaecf0;
        border-bottom: 1px solid #eaecf0;
    }

    .checkout-info-item {
        padding: 16px 18px 16px 0;
    }

        .checkout-info-item:not(:last-child) {
            border-right: 1px solid #eaecf0;
            margin-right: 18px;
            padding-right: 18px;
        }

    .info-label {
        display: block;
        color: var(--omni-muted);
        font-size: 12px;
        margin-bottom: 5px;
    }

    .info-value {
        display: block;
        color: var(--omni-text);
        font-size: 16px;
        font-weight: 700;
    }

    .checkout-card-actions {
        display: flex;
        justify-content: flex-end;
        padding-top: 18px;
    }

    .checkout-btn {
        min-width: 170px;
        height: 45px;
        padding: 0 20px;
        color: #fff;
        background: var(--omni-orange);
        border: 1px solid var(--omni-orange);
        box-shadow: 0 3px 0 #b54708;
        border-radius: 0;
        font-weight: 800;
        cursor: pointer;
    }

        .checkout-btn:hover {
            background: var(--omni-orange-dark);
            border-color: var(--omni-orange-dark);
        }

    .checkout-empty {
        padding: 46px 24px;
        text-align: center;
        background: var(--omni-green-soft);
        color: var(--omni-green-dark);
        border: 1px solid #abefc6;
        border-left: 5px solid var(--omni-green);
    }

        .checkout-empty h3 {
            margin: 0 0 6px;
            color: #05603a;
            font-size: 22px;
        }

        .checkout-empty p {
            margin: 0;
        }

    .checkout-footer {
        margin-top: 18px;
    }

    .back-checkin {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 48px;
        padding: 0 20px;
        color: var(--omni-blue-dark);
        background: var(--omni-blue-soft);
        border: 1px solid #84adff;
        border-left: 4px solid var(--omni-blue);
        text-decoration: none;
        font-weight: 800;
    }

        .back-checkin:hover {
            color: #004eeb;
            background: #dbeafe;
            text-decoration: none;
        }

    .checkout-hidden {
        display: none !important;
    }

    @@media (max-width: 900px) {
        .checkout-hero {
            flex-direction: column;
        }

        .checkout-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .checkout-search {
            max-width: none;
        }

        .checkout-info-grid {
            grid-template-columns: 1fr;
        }

        .checkout-info-item:not(:last-child) {
            border-right: 0;
            border-bottom: 1px solid #eaecf0;
            margin-right: 0;
        }
    }

    @@media (max-width: 576px) {
        .checkout-page {
            padding: 22px 12px 40px;
        }

        .checkout-title {
            font-size: 32px;
        }

        .checkout-card {
            padding: 0 18px 18px;
        }

        .checkout-card-head {
            margin: 0 -18px;
            padding: 14px 18px;
        }

        .checkout-card-actions {
            justify-content: stretch;
        }

        .checkout-btn {
            width: 100%;
        }

        .back-checkin {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="checkout-page">
    <div class="checkout-hero">
        <div>
            <h1 class="checkout-title">Check-out xe</h1>
            <p class="checkout-subtitle">Theo dõi xe đang gửi và thực hiện check-out khi khách rời bãi</p>
        </div>

        <div class="checkout-stat">
            <div class="checkout-stat-icon">P</div>
            <div>
                <span>Xe đang gửi</span>
                <strong>@Model.Count <small>xe</small></strong>
            </div>
        </div>
    </div>

    @if (ViewBag.CheckoutResult != null)
    {
        <div class="checkout-message" role="status">@ViewBag.CheckoutResult</div>
    }

    @if (Model.Any())
    {
        <div class="checkout-toolbar">
            <div class="checkout-search">
                <input id="checkoutSearch" type="text" class="checkout-search-input" placeholder="Nhập biển số xe để tìm nhanh..." autocomplete="off" />
                <button type="button" id="checkoutSearchButton" class="checkout-search-btn">Tìm kiếm</button>
            </div>
            <div class="checkout-count">Đang hiển thị <span id="visibleVehicleCount">@Model.Count</span> xe</div>
        </div>

        <div class="checkout-list" id="checkoutList">
            @foreach (var s in Model)
            {
                var duration = DateTime.Now - s.CheckInTime;
                var durationText = duration.TotalHours >= 1
                ? $"{(int)duration.TotalHours} giờ {Math.Max(0, duration.Minutes)} phút"
                : $"{Math.Max(0, (int)duration.TotalMinutes)} phút";

                <article class="checkout-card" data-license-plate="@s.LicensePlate.ToLower()">
                    <div class="checkout-card-head">
                        <div>
                            <div class="plate-label">Biển số xe</div>
                            <h2 class="plate-number">@s.LicensePlate</h2>
                        </div>
                        <span class="checkout-status">ĐANG GỬI</span>
                    </div>

                    <div class="checkout-info-grid">
                        <div class="checkout-info-item">
                            <span class="info-label">Vị trí đỗ</span>
                            <span class="info-value">@s.SlotCode</span>
                        </div>
                        <div class="checkout-info-item">
                            <span class="info-label">Giờ vào</span>
                            <span class="info-value">@s.CheckInTime.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                        <div class="checkout-info-item">
                            <span class="info-label">Thời gian đã gửi</span>
                            <span class="info-value">@durationText</span>
                        </div>
                    </div>

                    <div class="checkout-card-actions">
                        <form method="post" asp-action="DoCheckOut" style="margin:0;" onsubmit="return confirm('Xác nhận check-out xe @s.LicensePlate?');">
                            <input type="hidden" name="sessionId" value="@s.ParkingSessionId" />
                            <button type="submit" class="checkout-btn">Check-out xe</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="checkout-empty">
            <h3>Không có xe đang gửi</h3>
            <p>Hiện tại không có phiên gửi xe nào đang hoạt động.</p>
        </div>
    }

    <div class="checkout-footer">
        <a asp-action="CheckIn" class="back-checkin">⇄ Quay lại màn hình Check-in</a>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("checkoutSearch");
        const button = document.getElementById("checkoutSearchButton");
        const cards = document.querySelectorAll(".checkout-card");
        const countElement = document.getElementById("visibleVehicleCount");

        if (!input || cards.length === 0) return;

        function filterVehicles() {
            const keyword = input.value.trim().toLowerCase().replace(/\s/g, "");
            let visibleCount = 0;

            cards.forEach(card => {
                const plate = (card.dataset.licensePlate || "").replace(/\s/g, "");
                const show = plate.includes(keyword);
                card.classList.toggle("checkout-hidden", !show);
                if (show) visibleCount++;
            });

            if (countElement) countElement.textContent = visibleCount;
        }

        input.addEventListener("input", filterVehicles);
        button.addEventListener("click", filterVehicles);
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                filterVehicles();
            }
        });
    });
</script>
