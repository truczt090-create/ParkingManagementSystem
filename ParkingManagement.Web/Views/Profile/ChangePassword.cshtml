@model ParkingManagement.Web.ViewModels.Profile.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";

    var fullName = Context.Session.GetString("FullName") ?? "Người dùng";

    var phone = Context.Session.GetString("Phone");

    var avatar = Context.Session.GetString("AvatarUrl");

    var role = Context.Session.GetString("Role") ?? "Customer";

    var email = User.FindFirst(
        System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

    if (string.IsNullOrWhiteSpace(avatar))
    {
        avatar = "/images/default-avatar.png";
    }

    var roleName = role == "Owner"
        ? "Chủ bãi xe"
        : role == "Customer"
            ? "Khách hàng"
            : role;
}

<div class="profile-form-page">

    <div class="profile-form-heading">

        <span class="profile-eyebrow">
            TÀI KHOẢN OMNIPARK
        </span>

        <h1>Đổi mật khẩu</h1>

        <p>
            Cập nhật mật khẩu thường xuyên để bảo vệ tài khoản
            và thông tin của bạn một cách tốt nhất.
        </p>

    </div>


    <div class="profile-form-layout">

        <!-- SIDEBAR -->
        <aside class="profile-form-sidebar">

            <div class="profile-form-user-card">

                <div class="profile-form-avatar-wrap profile-avatar-online">

                    <img src="@avatar"
                         alt="Ảnh đại diện"
                         class="profile-form-avatar" />

                    <span class="profile-online-dot"></span>

                </div>

                <h2>@fullName</h2>

                <span class="profile-role-badge">

                    <i class="bi bi-shield-check"></i>
                    @roleName

                </span>


                <div class="profile-form-contact">

                    <div>
                        <i class="bi bi-envelope"></i>
                        <span>@email</span>
                    </div>

                    <div>
                        <i class="bi bi-telephone"></i>
                        <span>
                            @(string.IsNullOrWhiteSpace(phone)
                                ? "Chưa cập nhật"
                                : phone)
                        </span>
                    </div>

                </div>

            </div>


            <div class="profile-security-menu">

                <a asp-controller="Profile"
                   asp-action="Index">

                    <i class="bi bi-person"></i>
                    Hồ sơ

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-controller="Profile"
                   asp-action="Edit">

                    <i class="bi bi-pencil-square"></i>
                    Thông tin cá nhân

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-controller="Profile"
                   asp-action="ChangePassword"
                   class="active">

                    <i class="bi bi-lock"></i>
                    Đổi mật khẩu

                </a>

            </div>

        </aside>


        <!-- MAIN -->
        <main class="profile-form-main">

            <form asp-controller="Profile"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="profile-form-card">

                    <div class="profile-password-heading">

                        <div class="profile-password-shield">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <div>
                            <h2>Bảo mật tài khoản</h2>

                            <p>
                                Hãy đảm bảo mật khẩu của bạn đủ mạnh
                                để bảo vệ tài khoản khỏi các truy cập trái phép.
                            </p>
                        </div>

                    </div>


                    <div asp-validation-summary="ModelOnly"
                         class="profile-validation-summary"
                         role="alert">
                    </div>


                    <!-- CURRENT PASSWORD -->
                    <div class="profile-edit-group">

                        <label asp-for="CurrentPassword">
                            Mật khẩu hiện tại
                            <span>*</span>
                        </label>

                        <div class="profile-edit-input">

                            <i class="bi bi-lock"></i>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   id="currentPassword"
                                   placeholder="Nhập mật khẩu hiện tại"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="profile-password-toggle"
                                    data-target="currentPassword">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword"
                              class="profile-field-error">
                        </span>

                    </div>


                    <!-- NEW PASSWORD -->
                    <div class="profile-edit-group">

                        <label asp-for="NewPassword">
                            Mật khẩu mới
                            <span>*</span>
                        </label>

                        <div class="profile-edit-input">

                            <i class="bi bi-key"></i>

                            <input asp-for="NewPassword"
                                   type="password"
                                   id="newPassword"
                                   placeholder="Nhập mật khẩu mới"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="profile-password-toggle"
                                    data-target="newPassword">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="profile-field-error">
                        </span>

                    </div>


                    <!-- CONFIRM -->
                    <div class="profile-edit-group">

                        <label asp-for="ConfirmPassword">
                            Xác nhận mật khẩu mới
                            <span>*</span>
                        </label>

                        <div class="profile-edit-input">

                            <i class="bi bi-key-fill"></i>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPassword"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="profile-password-toggle"
                                    data-target="confirmPassword">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="profile-field-error">
                        </span>

                    </div>


                    <!-- REQUIREMENTS -->
                    <div class="profile-password-requirements">

                        <div class="profile-requirements-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <strong>
                                Mật khẩu nên đáp ứng các yêu cầu sau:
                            </strong>

                            <ul>
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    Ít nhất 6 ký tự
                                </li>

                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    Nên kết hợp chữ hoa, chữ thường và số
                                </li>

                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    Không chia sẻ mật khẩu với người khác
                                </li>
                            </ul>

                        </div>

                    </div>


                    <div class="profile-form-actions">

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="profile-cancel-btn">

                            <i class="bi bi-arrow-left"></i>
                            Quay lại

                        </a>


                        <button type="submit"
                                class="profile-save-btn">

                            <i class="bi bi-lock"></i>
                            Cập nhật mật khẩu

                        </button>

                    </div>

                </div>

            </form>

        </main>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll(".profile-password-toggle")
            .forEach(button => {

                button.addEventListener("click", function () {

                    const targetId =
                        this.getAttribute("data-target");

                    const input =
                        document.getElementById(targetId);

                    const icon =
                        this.querySelector("i");

                    if (input.type === "password") {

                        input.type = "text";

                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");

                    } else {

                        input.type = "password";

                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            });
    </script>
}