@model List<ParkingManagement.Web.ViewModels.Owner.EmployeeSummaryViewModel>

@{
    ViewData["Title"] = "Quản lý nhân viên";
    var lotId = (int)ViewBag.ParkingLotId;
}

<div class="owner-employee-page">

    <div class="owner-employee-heading">
        <div>
            <span class="owner-employee-kicker">OMNIPARK OWNER</span>
            <h1>
                <i class="bi bi-people-fill"></i>
                Quản lý nhân viên
            </h1>
            <p>Quản lý và phân quyền nhân viên cho bãi xe của bạn.</p>
        </div>

        <a href="#createEmployeeForm" class="owner-employee-add-top">
            <i class="bi bi-plus-lg"></i>
            Thêm nhân viên mới
        </a>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="owner-employee-alert owner-employee-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @ViewBag.SuccessMessage
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="owner-employee-alert owner-employee-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            @ViewBag.Error
        </div>
    }

    <!-- DANH SÁCH NHÂN VIÊN -->
    <section class="owner-employee-card">

        <div class="owner-employee-card-title">
            <div>
                <h2>Danh sách nhân viên</h2>
                <p>Các tài khoản nhân viên đang thuộc bãi xe này.</p>
            </div>

            <span class="owner-employee-count">
                @Model.Count nhân viên
            </span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="owner-employee-table-wrap">
                <table class="owner-employee-table">
                    <thead>
                        <tr>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Ca làm</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td>
                                    <div class="owner-employee-user">
                                        <div class="owner-employee-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>

                                        <div>
                                            <strong>@employee.FullName</strong>
                                            <small>Nhân viên</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="owner-employee-email">
                                        @employee.Email
                                    </span>
                                </td>

                                <td>
                                    <span class="owner-shift-badge">
                                        @(string.IsNullOrWhiteSpace(employee.Shift)
                                            ? "Chưa phân ca"
                                            : employee.Shift)
                                    </span>
                                </td>

                                <td>
                                    <span class="owner-working-badge">
                                        <i class="bi bi-circle-fill"></i>
                                        Đang làm
                                    </span>
                                </td>

                                <td class="text-end">
                                    <form asp-controller="Owner"
                                          asp-action="RemoveEmployee"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa nhân viên này khỏi bãi xe?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="employeeId"
                                               value="@employee.EmployeeId" />

                                        <input type="hidden"
                                               name="lotId"
                                               value="@lotId" />

                                        <button type="submit"
                                                class="owner-employee-delete-btn"
                                                title="Xóa nhân viên">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="owner-employee-empty">
                <div class="owner-employee-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>Chưa có nhân viên</h3>
                <p>Bãi xe này hiện chưa có tài khoản nhân viên nào.</p>
            </div>
        }

    </section>


    <!-- FORM TẠO NHÂN VIÊN -->
    <section id="createEmployeeForm"
             class="owner-employee-card owner-create-employee-card">

        <div class="owner-create-employee-title">
            <div class="owner-create-title-bar"></div>

            <div>
                <h2>Thêm nhân viên mới</h2>
                <p>Tạo tài khoản đăng nhập cho nhân viên của bãi xe.</p>
            </div>
        </div>

        <form asp-controller="Owner"
              asp-action="CreateEmployee"
              method="post"
              class="owner-employee-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ParkingLotId"
                   value="@lotId" />

            <div class="owner-employee-form-grid">

                <!-- HỌ TÊN -->
                <div class="owner-employee-field">
                    <label>
                        Họ tên <span>*</span>
                    </label>

                    <div class="owner-employee-input-wrap">
                        <i class="bi bi-person"></i>

                        <input type="text"
                               name="FullName"
                               placeholder="Nhập họ tên nhân viên"
                               required />
                    </div>
                </div>


                <!-- SỐ ĐIỆN THOẠI -->
                <div class="owner-employee-field">
                    <label>
                        Số điện thoại <span>*</span>
                    </label>

                    <div class="owner-employee-input-wrap">
                        <i class="bi bi-telephone"></i>

                        <input type="tel"
                               name="Phone"
                               placeholder="Nhập số điện thoại"
                               required />
                    </div>
                </div>


                <!-- EMAIL -->
                <div class="owner-employee-field">
                    <label>
                        Email <span>*</span>
                    </label>

                    <div class="owner-employee-input-wrap">
                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               name="Email"
                               placeholder="Nhập email"
                               required />
                    </div>
                </div>


                <!-- CA LÀM -->
                <div class="owner-employee-field">
                    <label>
                        Ca làm <span>*</span>
                    </label>

                    <div class="owner-employee-input-wrap">
                        <i class="bi bi-clock"></i>

                        <select name="Shift" required>
                            <option value="">Chọn ca làm</option>
                            <option value="Sáng">Ca sáng</option>
                            <option value="Chiều">Ca chiều</option>
                            <option value="Tối">Ca tối</option>
                        </select>
                    </div>
                </div>


                <!-- PASSWORD -->
                <div class="owner-employee-field">
                    <label>
                        Mật khẩu tạm <span>*</span>
                    </label>

                    <div class="owner-employee-input-wrap">
                        <i class="bi bi-lock"></i>

                        <input type="password"
                               name="Password"
                               id="employeePassword"
                               placeholder="Nhập mật khẩu tạm"
                               required />

                        <button type="button"
                                class="owner-password-toggle"
                                onclick="toggleEmployeePassword()">
                            <i id="employeePasswordIcon"
                               class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>


                <!-- NOTE -->
                <div class="owner-employee-info">
                    <i class="bi bi-info-circle"></i>

                    <p>
                        Nhân viên sẽ được cấp một tài khoản để đăng nhập
                        vào hệ thống và thực hiện các nghiệp vụ tại bãi xe.
                    </p>
                </div>

            </div>


            <div class="owner-employee-actions">

                <button type="submit"
                        class="owner-create-employee-btn">
                    <i class="bi bi-person-plus"></i>
                    Tạo tài khoản nhân viên
                </button>

                <a asp-controller="Owner"
                   asp-action="MyLots"
                   class="owner-employee-back-btn">
                    <i class="bi bi-x-lg"></i>
                    Quay lại
                </a>

            </div>

        </form>

    </section>

</div>


@section Scripts {

    <script>
        function toggleEmployeePassword() {
            const input = document.getElementById("employeePassword");
            const icon = document.getElementById("employeePasswordIcon");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}