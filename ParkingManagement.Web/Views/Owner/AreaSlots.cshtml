@model List<ParkingManagement.Web.ViewModels.Owner.SlotViewModel>

@{
    ViewData["Title"] = "Vị trí đỗ";

    var areaId = (int)ViewBag.ParkingAreaId;
    var lotId = (int)ViewBag.ParkingLotId;
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            Quản lý vị trí đỗ
        </h1>

        <p class="text-muted mb-0">
            Khu vực #@areaId
        </p>
    </div>


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success">
            @ViewBag.SuccessMessage
        </div>
    }


    <!-- =====================================================
         TẠO HÀNG LOẠT
    ====================================================== -->

    <div class="card mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-1">
                Tạo nhiều vị trí đỗ
            </h2>

            <small class="text-muted">
                Nhập số lượng để hệ thống tự tạo mã vị trí.
            </small>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-controller="Owner"
                  asp-action="CreateBulkSlots">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ParkingAreaId"
                       value="@areaId" />

                <input type="hidden"
                       name="lotId"
                       value="@lotId" />


                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Loại xe
                        </label>

                        <select name="VehicleTypeId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Chọn loại xe --
                            </option>

                            <option value="1">
                                Xe máy
                            </option>

                            <option value="2">
                                Ô tô
                            </option>

                            <option value="3">
                                Xe đạp
                            </option>

                        </select>
                    </div>


                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Số lượng chỗ
                        </label>

                        <input type="number"
                               name="Quantity"
                               class="form-control"
                               min="1"
                               max="500"
                               placeholder="VD: 30"
                               required />

                        <small class="text-muted">
                            Tối đa 500 chỗ/lần.
                        </small>
                    </div>


                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Tiền tố mã vị trí
                        </label>

                        <input type="text"
                               name="Prefix"
                               class="form-control"
                               value="A"
                               maxlength="10"
                               required />

                        <small class="text-muted">
                            VD: A → A-01, A-02...
                        </small>
                    </div>

                </div>


                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">

                        Tạo vị trí hàng loạt

                    </button>
                </div>

            </form>

        </div>
    </div>


    <!-- =====================================================
         TẠO 1 VỊ TRÍ
    ====================================================== -->

    <div class="card mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-1">
                Thêm một vị trí
            </h2>

            <small class="text-muted">
                Dùng khi bạn chỉ muốn tạo một chỗ riêng lẻ.
            </small>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-controller="Owner"
                  asp-action="CreateSlot">

                <input type="hidden"
                       name="ParkingAreaId"
                       value="@areaId" />

                <input type="hidden"
                       name="lotId"
                       value="@lotId" />


                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Mã vị trí
                        </label>

                        <input type="text"
                               name="SlotCode"
                               class="form-control"
                               placeholder="VD: A-01"
                               required />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Loại xe
                        </label>

                        <select name="VehicleTypeId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Chọn loại xe --
                            </option>

                            <option value="1">
                                Xe máy
                            </option>

                            <option value="2">
                                Ô tô
                            </option>

                            <option value="3">
                                Xe đạp
                            </option>

                        </select>

                    </div>

                </div>


                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-outline-primary">

                        Thêm một vị trí

                    </button>

                </div>

            </form>

        </div>
    </div>


    <!-- =====================================================
         DANH SÁCH VỊ TRÍ
    ====================================================== -->

    <div class="card">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <div>
                <h2 class="h5 mb-1">
                    Danh sách vị trí
                </h2>

                <small class="text-muted">
                    Tổng cộng @Model.Count vị trí
                </small>
            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            Mã vị trí
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Loại xe
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center text-muted py-4">

                                Chưa có vị trí đỗ nào.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @s.SlotCode
                                    </strong>
                                </td>


                                <td>

                                    @if (s.Status == "Trống")
                                    {
                                        <span class="badge bg-success">
                                            Trống
                                        </span>
                                    }
                                    else if (s.Status == "Đang sử dụng")
                                    {
                                        <span class="badge bg-danger">
                                            Đang sử dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @s.Status
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (s.VehicleTypeId == 1)
                                    {
                                        <span>Xe máy</span>
                                    }
                                    else if (s.VehicleTypeId == 2)
                                    {
                                        <span>Ô tô</span>
                                    }
                                    else if (s.VehicleTypeId == 3)
                                    {
                                        <span>Xe đạp</span>
                                    }
                                    else
                                    {
                                        <span>
                                            ID @s.VehicleTypeId
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <div class="mt-4">

        <a asp-action="LotDetail"
           asp-route-lotId="@lotId"
           class="btn btn-outline-dark">

            ← Quay lại bãi xe

        </a>

    </div>

</div>